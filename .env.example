# reel-engine-v2 — copia a .env y rellena. NUNCA comitear .env.
# Pipeline: python -m engine.pipeline {audition|plan|props|render|full|status|reset}
MAX_STAGE_RETRIES=2           # circuit breaker por etapa; al agotarse el pipeline PARA y reporta
PROVIDER_MODE=mock            # mock | real
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_SPEED=0.98
ELEVENLABS_STABILITY=0.68
ELEVENLABS_SIMILARITY=0.84
ELEVENLABS_STYLE=0.12
ELEVENLABS_MIN_SPEED=0.98
ELEVENLABS_MAX_SPEED=1.05
LONGFORM_TTS_LOCK_SPEED=1
LONGFORM_TTS_ALLOW_SLOWDOWN=0
LONGFORM_SCRIPT_MIN_WPM=180
LONGFORM_SCRIPT_MAX_WPM=200
ELEVENLABS_USE_SPEAKER_BOOST=1
ENABLE_VOICE_TIGHTEN=0
# Opcional si necesitas recortar pausas manualmente: ENABLE_VOICE_TIGHTEN=1, VOICE_TIGHTEN_MIN_MS=240, VOICE_TIGHTEN_KEEP_MS=160
# Google Gemini Omni Flash solo para visuales generativos justificados. No es default del hook.
GEMINI_API_KEY=
OMNI_VIDEO_MODEL=gemini-omni-flash-preview
OMNI_VIDEO_ASPECT_RATIO=9:16
OMNI_VIDEO_DELIVERY=uri
OMNI_VIDEO_BACKGROUND=0
OMNI_VIDEO_STORE=0
OMNI_VIDEO_STREAM=0
AVATAR_PROVIDER=kreado
KREADO_BACKEND_URL=http://localhost:8787
KREADO_GENERATE_PATH=/api/kreado/generate
KREADO_HUMAN_ID=515947
KREADO_ASPECT_RATIO=16:9
KREADO_TASK_STATE=work\kreado_tasks.jsonl
KREADO_MANAGED=1
KREADO_WORKDIR=C:\ruta\a\kreado-automation
KREADO_READY_TIMEOUT=25
# Tests baratos: reutiliza videos Omni cacheados cuando el plan los justifique y falla si falta cache.
REUSE_OMNI_VIDEO_CLIPS=0
# Cache/fail-fast de pruebas. NO_PROVIDER_CALLS=1 corta si falta cache en vez de llamar proveedores.
REUSE_TTS=0
REGEN_TTS=0
REGEN_HOOK=0
REGEN_AVATAR=0
REGEN_VIDEO=0
REGEN_CLIP_EXTRACTOR=0
REGEN_PEXELS=0
REGEN_IMAGE=0
REGEN_OVERLAY_IMAGES=0
NO_PROVIDER_CALLS=0
# Conserva identidad con avatar_key/prompt, pero no recicles clips hablados por default.
REUSE_AVATAR_CLIP=0
# Kreado: tokens privados solo viven en el backend kreado-automation, nunca en frontend ni Reel Engine.
# Dev: mantener Chrome logueado con CDP en http://localhost:9222; si falla, correr `neo start`.
PEXELS_API_KEY=              # Stock horizontal para acciones humanas genericas filmables.
PEXELS_QUERY=                # Opcional. El compilador longform genera sujeto + accion + entorno.
# Clip Extractor local/Tailscale: solo fuentes identificables: sucesos reales, declaraciones, comentarios ajenos, peliculas, series o videos musicales. Nunca usar como Pexels.
CLIP_EXTRACTOR_BASE_URL=http://100.121.147.73:8765
CLIP_EXTRACTOR_MODEL=gemma-local
CLIP_EXTRACTOR_VLLM_BASE_URL=http://127.0.0.1:18100/v1
CLIP_EXTRACTOR_OUTPUT_DIR=./clips
CLIP_EXTRACTOR_POLL_SECONDS=1.5
CLIP_EXTRACTOR_TIMEOUT=900
CLIP_EXTRACTOR_HEALTH_TIMEOUT=15
CLIP_EXTRACTOR_SUBMIT_TIMEOUT=60
CLIP_EXTRACTOR_DOWNLOAD_TIMEOUT=300
CLIP_EXTRACTOR_MANAGED=0
# Cutout Motion REST: animacion editorial por sprites para conceptos y secuencias.
# Proveedor preferido para mecanismos fisiologicos, comparaciones y secuencias explicativas.
CUTOUT_PROVIDER_ENABLED=1
CUTOUT_BASE_URL=http://127.0.0.1:8000
CUTOUT_API_KEY=
CUTOUT_ALLOW_REMOTE=0
CUTOUT_MANAGED=1
CUTOUT_WORKDIR=C:\ruta\al\servidor-cutout
CUTOUT_READY_TIMEOUT=35
CUTOUT_ASSET_PROVIDER=codex-oauth
CUTOUT_STYLE_SCOPE=Adrian Yepez editorial crema negro verde petroleo dorado v1
CUTOUT_MOTION_PLANNER=rules
CUTOUT_PROMPT_REFINER=none
CUTOUT_POLL_SECONDS=1.5
CUTOUT_TIMEOUT=210
CUTOUT_DOWNLOAD_TIMEOUT=300
CUTOUT_MIN_SOURCE_RATIO=0.85
CUTOUT_MAX_SOURCE_RATIO=1.50
LONGFORM_SCENE_ASSET_BUDGET_SECONDS=180
LONGFORM_CLIP_EXTRACTOR_BUDGET_SECONDS=70
LONGFORM_PEXELS_BUDGET_SECONDS=45
# En real, fallos de assets cortan el job. Solo para prototipos con placeholders:
ALLOW_ASSET_FALLBACKS=0
# Guion legacy (LLM): codex = suscripcion Codex | openai = OPENAI_API_KEY | vllm/spark/gemma = OpenAI-compatible en Spark | litellm = LiteLLM | mock = tema directo
LLM_PROVIDER=codex
CODEX_HOME=C:\Users\kenny\.codex  # requerido para IMAGE_PROVIDER=codex, clip.source=image, image_slots o LLM_PROVIDER=codex
SCRIPT_DURATION_SECONDS=40  # el skill decide 25-35/40-55/60-75 por complejidad del tema
SCRIPT_WORDS=120 a 155       # largo objetivo para 45-60s de voz. Ajusta solo si el TTS real queda fuera de rango.
SCRIPT_MIN_WORDS=105
SCRIPT_MAX_WORDS=175
SCRIPT_AUDIENCE=audiencia de Reels
SCRIPT_OBJECTIVE=retener y explicar una idea clara
SCRIPT_CTA=guardar, comentar o seguir segun el tema
LLM_TEMPERATURE=0.35
LLM_ANGLE_RETRIES=3
LLM_ANGLE_MAX_TOKENS=1600
LLM_SCRIPT_RETRIES=4
LLM_MAX_TOKENS=900
LLM_TIMEOUT=120
SCRIPT_AUDITION_WRITERS=codex,gemma
SCRIPT_AUDITION_MIN_SCORE=62
# QA por IA: bloquea plan, props/assets y render MP4. Los scripts quedan como guardrails mecanicos.
AI_QA_ENABLED=1
AI_QA_REQUIRED=1
AI_QA_PROVIDER=codex  # codex recomendado para vision; gemma/vllm solo sirve para QA textual

# QA auditivo local por muestras (hook, mitad y CTA). El proveedor se enciende
# automaticamente si no responde y se apaga al terminar cuando lo inicio el motor.
GEMMA_AUDIO_QA_ENABLED=0
GEMMA_AUDIO_QA_URL=http://127.0.0.1:18110
GEMMA_AUDIO_RUNTIME=E:\AI\Runtimes\gemma4-audio
GEMMA_AUDIO_QA_MAX_SAMPLES=3
GEMMA_AUDIO_QA_MAX_WER=0.15
GEMMA_AUDIO_QA_TIMEOUT_SECONDS=900
AI_QA_MIN_SCORE=75
AI_QA_TIMEOUT=240
AI_QA_MAX_TOKENS=1400
TTS_QA_TRANSCRIBE=1
TTS_QA_REQUIRE_TRANSCRIPT=1  # produccion: bloquear si no hay transcripcion independiente del TTS
TTS_QA_TRANSCRIBE_PROVIDER=elevenlabs,whisperx
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_LANGUAGE=spa
ELEVENLABS_STT_TIMEOUT=180
VLLM_BASE_URL=http://spark:18100/v1
VLLM_MODEL=gemma-local
VLLM_API_KEY=
# Alternativa si quieres pasar por LiteLLM en Spark (requiere key privada):
LITELLM_BASE_URL=http://spark:4000/v1
LITELLM_MODEL=
LITELLM_API_KEY=
IMAGE_PROVIDER=codex
CODEX_IMAGE_MODEL=gpt-image-2
CODEX_IMAGE_SIZE=1536x1024
# Imagen generada usa OAuth Codex desde CODEX_HOME/auth.json. No requiere OPENAI_API_KEY.
OPENAI_API_KEY=              # solo si LLM_PROVIDER=openai
# Alignment real: ElevenLabs timestamps por default. Opcional: ALIGNER=whisperx.
ALIGNER=elevenlabs
WHISPERX_MODEL=base
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE=int8
WHISPERX_LANG=es
