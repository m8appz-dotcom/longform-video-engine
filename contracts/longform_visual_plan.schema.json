{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "longform_visual_plan.schema.json",
  "title": "Longform feasibility-routed visual plan",
  "type": "object",
  "required": ["schemaVersion", "runId", "scriptHash", "durationMs", "shots"],
  "properties": {
    "schemaVersion": {"enum": ["2.0", "3.0", "3.1", "3.2"]},
    "runId": {"type": "string"},
    "scriptHash": {"type": "string"},
    "durationMs": {"type": "integer", "minimum": 1},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shotId", "evidenceBeatId", "proofKind", "beatRole", "requiredEvidence",
          "preferredMedium", "forbiddenSubstitutions", "evidenceMode",
          "requiresReadableData", "requiresContinuity", "temporalAction",
          "continuityGroup", "peoplePolicy", "noveltyKey", "route", "routePlan", "queryVariants"
        ],
        "properties": {
          "shotId": {"type": "string", "pattern": "^S[0-9]{4}$"},
          "evidenceBeatId": {"type": "string", "pattern": "^B[0-9]{3}$"},
          "proofKind": {"enum": ["human_action", "real_event", "third_party_commentary", "cultural_reference", "product_inspection", "physiological_mechanism", "comparison", "exact_ui_state", "presenter", "abstract_concept"]},
          "mediaNeedKind": {"type": "string"},
          "beatRole": {"type": "string", "minLength": 2},
          "requiredEvidence": {"type": "string", "minLength": 3},
          "preferredMedium": {"enum": ["clip_extractor", "pexels", "image", "image_pair", "cutout_motion", "omni", "ui", "motion-card", "avatar"]},
          "forbiddenSubstitutions": {"type": "array", "items": {"type": "string"}},
          "evidenceMode": {"enum": ["illustrative", "demonstrative", "documentary", "data_exact"]},
          "requiresReadableData": {"type": "boolean"},
          "requiresContinuity": {"type": "boolean"},
          "requiresStateContinuity": {"type": "boolean"},
          "temporalAction": {"enum": ["single", "multi_step"]},
          "continuityGroup": {"type": "string"},
          "peoplePolicy": {"enum": ["forbidden", "contextual", "required"]},
          "presenterAllowed": {"type": "boolean"},
          "maxFaceAreaRatio": {"type": "number", "minimum": 0, "maximum": 1},
          "evidenceMustRemainDominant": {"type": "boolean"},
          "noveltyKey": {"type": "string", "minLength": 3},
          "route": {"enum": ["clip_extractor", "pexels", "image", "image_pair", "cutout_motion", "omni", "ui", "motion-card", "avatar"]},
          "routePlan": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}},
          "queryVariants": {"type": "object"},
          "screenCopy": {"type": "string", "maxLength": 32},
          "visualStrategy": {"enum": ["media", "motion", "hybrid"]},
          "representation": {"enum": ["photo", "video", "editorial_illustration", "semantic_diagram", "ui", "3d"]},
          "semanticObjects": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
          "freehandDrawingAllowed": {"const": false},
          "textOwner": {"enum": ["asset", "remotion", "none"]},
          "backgroundTextPolicy": {"enum": ["forbidden", "incidental", "focal"]},
          "maxBackgroundWords": {"type": "integer", "minimum": 0, "maximum": 80},
          "overlayZones": {"type": "array", "items": {"type": "string"}},
          "evidenceZone": {"type": "string"},
          "ctaAnchor": {"type": "boolean"},
          "rendererVersion": {"enum": ["semantic-v1", "semantic-v2"]},
          "fallbackRenderer": {"const": "semantic-v1"},
          "artDirection": {"enum": ["editorial", "technical", "documentary", "data"]},
          "evidenceLayer": {"enum": ["media", "vector", "ui", "3d"]},
          "annotationLayer": {"enum": ["remotion", "none"]},
          "motionPattern": {"enum": ["technical-reveal", "layer-build", "evidence-scan", "editorial-split", "focus-pull", "cta-path"]},
          "uiSpec": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
