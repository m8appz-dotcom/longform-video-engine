{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approved_script.schema.json",
  "title": "ApprovedLongformScript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "script_locked", "script_hash", "title", "thumbnail_promise", "hook", "target_minutes", "audience_profile", "chapters"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "script_locked": {"const": true},
    "script_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 120},
    "thumbnail_promise": {"type": "string", "minLength": 4, "maxLength": 100},
    "hook": {"type": "string", "minLength": 8, "maxLength": 500},
    "target_minutes": {"type": "number", "minimum": 2, "maximum": 45},
    "language": {"type": "string", "default": "es"},
    "audience_profile": {"type": "string", "minLength": 40},
    "avatar_feedback": {"type": "string", "default": ""},
    "avatar_appearances": {"const": 2},
    "design_source": {
      "oneOf": [
        {"type": "string", "minLength": 3},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {
          "type": {"enum": ["url", "instructions", "file"]},
          "value": {"type": "string", "minLength": 3}
        }}
      ]
    },
    "design_instructions": {"type": "string"},
    "design_profile": {"type": "object"},
    "product_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fictional_brand": {"type": "string", "minLength": 2, "maxLength": 32},
        "product_name": {"type": "string", "minLength": 2, "maxLength": 48},
        "product_size": {"type": "string", "maxLength": 24},
        "label_language": {"type": "string", "maxLength": 12}
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spoken_text", "target_video_title", "screen_copy", "end_screen_hold_seconds"],
      "properties": {
        "spoken_text": {"type": "string", "minLength": 18},
        "target_video_title": {"type": "string", "minLength": 8, "maxLength": 120},
        "target_video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
        "target_channel_id": {"type": "string", "minLength": 8},
        "target_url": {"type": "string", "pattern": "^https://(www\\.)?youtube\\.com/"},
        "visibility": {"enum": ["public", "unlisted", "private", "playlist", "subscribe", "none"]},
        "verified": {"type": "boolean"},
        "verified_at": {"type": "string", "minLength": 10},
        "screen_copy": {"type": "string", "minLength": 4, "maxLength": 60},
        "end_screen_hold_seconds": {"type": "number", "minimum": 8, "maximum": 10}
      }
    },
    "user_clips": {"type": "array", "default": [], "items": {"type": "object", "additionalProperties": false, "required": ["path", "description"], "properties": {"path": {"type": "string"}, "description": {"type": "string", "minLength": 3}, "shot_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{4}$"}}, "start_ms": {"type": "integer", "minimum": 0}}}},
    "chapters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]{2}$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 80},
          "text": {"type": "string", "minLength": 80},
          "spoken_text": {"type": "string", "minLength": 80},
          "production_notes": {"type": "string"}
        }
      }
    }
  }
}
